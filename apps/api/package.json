{
  "name": "@paysync/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:worker": "node dist/src/workers/main.js",
    "start:dev": "node --watch --import @swc-node/register/esm-register src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "openapi:generate": "tsc -p tsconfig.build.json && node dist/src/openapi.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/with-pg.mjs prisma migrate dev",
    "prisma:migrate:create": "node scripts/with-pg.mjs prisma migrate dev --create-only",
    "prisma:status": "node scripts/with-pg.mjs prisma migrate status",
    "db:seed": "node scripts/with-pg.mjs prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/swagger": "8.1.1",
    "@node-rs/argon2": "2.0.2",
    "@paysync/parsers": "workspace:*",
    "@paysync/shared": "workspace:*",
    "@prisma/client": "6.2.1",
    "bullmq": "5.34.10",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.7",
    "express": "4.21.2",
    "helmet": "8.0.0",
    "ioredis": "5.4.2",
    "otplib": "12.0.1",
    "qrcode": "1.5.4",
    "nestjs-pino": "4.3.0",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "yaml": "2.6.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.15",
    "@swc-node/register": "1.10.9",
    "@swc/core": "1.13.5",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/pg": "8.11.10",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.2",
    "embedded-postgres": "16.14.0-beta.17",
    "pg": "8.13.1",
    "prisma": "6.2.1",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "unplugin-swc": "1.5.1",
    "vitest": "2.1.8"
  }
}
