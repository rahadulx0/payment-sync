{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true
  },
  // The seed is compiled too: production images have no tsx, and seeding the
  // first admin is a step you run inside the container (docs/deployment-dokploy.md).
  "include": ["src/**/*.ts", "prisma/seed.ts"]
}
