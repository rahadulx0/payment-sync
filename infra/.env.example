# payment-sync configuration (workplan/README.md §7).
# Copy to .env at the repo root for local dev: `cp infra/.env.example .env`.
# NEVER commit a filled-in .env. Dev defaults below match infra/docker-compose.dev.yml.

# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Containers and processes run UTC; presentation converts to Asia/Dhaka.
TZ=UTC

# --- Datastores ---
# Dev Postgres is exposed on 5433, Redis on 6380 (see docker-compose.dev.yml).
DATABASE_URL=postgresql://paysync:paysync@localhost:5433/paysync?schema=public
REDIS_URL=redis://localhost:6380

# --- Cryptography ---
# 32-byte base64 key. Encrypts webhook secrets and TOTP secrets at rest (envelope encryption).
# Losing this in production is unrecoverable (CLAUDE.md). Generate: openssl rand -base64 32
KEY_ENCRYPTION_KEY=ZGV2LWtleS1lbmNyeXB0aW9uLWtleS0zMmJ5dGVzLXh4eHg=
# Admin JWTs. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# --- Admin dashboard ---
ADMIN_ORIGIN=http://localhost:3001
# Optional CIDR allowlist for /admin/* (comma-separated). Empty = no restriction.
ADMIN_IP_ALLOWLIST=

# --- Public URLs / webhooks ---
PUBLIC_API_URL=http://localhost:3000
WEBHOOK_USER_AGENT=payment-sync-webhook/1.0

# --- Observability ---
SENTRY_DSN=
METRICS_TOKEN=dev-metrics-token

# --- Alerting ---
ALERT_EMAIL=ops@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Backups (Task 16) ---
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
# Separate from KEY_ENCRYPTION_KEY. Generate: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=

# --- Rate limiting (overridable per company at runtime) ---
RATE_LIMIT_REGISTER_RPM=120

# --- Android release signing (CI only — never local) ---
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# --- Seed (dev/test only) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!Dev123
SEED_DEV=true
