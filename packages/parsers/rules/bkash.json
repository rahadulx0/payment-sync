    {
      "type": "CASH_IN",
      "direction": "CREDIT",
      "must_contain": ["Cash In", "from", "TrxID"],
      "must_not_contain": ["Cash Out", "Payment", "sent"],
      "patterns": {
        "amount": "Cash In (?:Tk|BDT)\\s*([0-9][0-9,]*(?:\\.[0-9]{1,2})?)",
        "sender_msisdn": "from\\s*(01[3-9][0-9]{8})",
        "fee": "Fee (?:Tk|BDT)\\s*([0-9][0-9,]*(?:\\.[0-9]{1,2})?)",
        "balance_after": "Balance (?:Tk|BDT)\\s*([0-9][0-9,]*(?:\\.[0-9]{1,2})?)",
        "transaction_id": "TrxID\\s*([A-Z0-9]{6,20})",
        "timestamp": "at\\s*([0-9]{2}/[0-9]{2}/[0-9]{4}\\s+[0-9]{2}:[0-9]{2})"
      },
      "timestamp_formats": ["dd/MM/yyyy HH:mm"],
      "required": ["amount", "transaction_id"]
    },
    {
